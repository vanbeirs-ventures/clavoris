{
  "$schema": "clavoris-tokens-v1",
  "name": "Clavoris",
  "source": "design/tokens.css (canonical)",
  "color": {
    "clavis-navy": "#1A3A5C",
    "seal-gold": "#B8860B",
    "parchment": "#F7F3EC",
    "slate": "#4A5568",
    "gold-light": "#D4A82A",
    "ink": "#1A1A2E",
    "rule": "#D8D0C4",
    "parch-dark": "#EDE7DA",
    "navy-900": "#122A44",
    "navy-700": "#1A3A5C",
    "navy-500": "#2E5279",
    "navy-300": "#6E83A0",
    "parch-100": "#FBF9F4",
    "white-paper": "#FFFFFF",
    "status-verified": "#2F6E4F",
    "status-pending": "#B8860B",
    "status-alert": "#9B2C2C",
    "status-info": "#2E5279",
    "verified-bg": "#E8F0EA",
    "pending-bg": "#F6EFD9",
    "alert-bg": "#F6E9E8",
    "fg-on-navy": "#F7F3EC",
    "fg-on-navy-2": "#B9C6D6",
    "border-strong": "#C4B9A6"
  },
  "semantic": {
    "fg-1": "var(--ink)",
    "fg-2": "var(--slate)",
    "fg-3": "var(--navy-300)",
    "fg-on-navy": "#F7F3EC",
    "fg-on-navy-2": "#B9C6D6",
    "accent": "var(--seal-gold)",
    "accent-hover": "var(--gold-light)",
    "bg-page": "var(--parchment)",
    "bg-surface": "var(--parch-100)",
    "bg-raised": "var(--white-paper)",
    "bg-navy": "var(--clavis-navy)",
    "bg-navy-deep": "var(--navy-900)",
    "bg-band": "var(--parch-dark)",
    "border": "var(--rule)",
    "border-strong": "#C4B9A6"
  },
  "font": {
    "display": "\"EB Garamond\", \"Garamond\", Georgia, serif",
    "ui": "\"Poppins\", \"Helvetica Neue\", Arial, sans-serif",
    "data": "\"Courier New\", \"Courier\", ui-monospace, monospace"
  },
  "fontWeight": {
    "light": "300",
    "regular": "400",
    "medium": "500",
    "semibold": "600",
    "bold": "700"
  },
  "fontSize": {
    "display": "44px",
    "h1": "32px",
    "h2": "23px",
    "h3": "16px",
    "body": "15px",
    "sm": "13px",
    "label": "11.5px",
    "caption": "11px"
  },
  "lineHeight": {
    "tight": "1.12",
    "snug": "1.3",
    "body": "1.55",
    "loose": "1.7"
  },
  "letterSpacing": {
    "label": "0.14em",
    "wide": "0.06em",
    "tight": "-0.01em"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "radius": {
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "lg": "10px",
    "pill": "999px"
  },
  "borderWidth": {
    "hair": "1px",
    "rule": "1.5px",
    "key": "3px"
  },
  "shadow": {
    "xs": "0 1px 2px rgba(18,42,68,0.06)",
    "sm": "0 1px 3px rgba(18,42,68,0.08), 0 1px 2px rgba(18,42,68,0.04)",
    "md": "0 4px 12px rgba(18,42,68,0.08), 0 1px 3px rgba(18,42,68,0.05)",
    "lg": "0 12px 32px rgba(18,42,68,0.12), 0 4px 8px rgba(18,42,68,0.06)",
    "navy": "0 16px 40px rgba(18,42,68,0.28)"
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "duration": "180ms",
    "durationSlow": "320ms"
  },
  "rules": [
    "Navy (#1A3A5C) is always dominant.",
    "Seal Gold (#B8860B) is an accent only: never more than ~15% of a composition, never a large fill, never body text on parchment.",
    "Every financial figure, ISIN, date, hash and identifier renders in the data (monospace) face.",
    "Radii stay near-square (max 10px; pills only for status chips).",
    "No emoji; the middot (·) is the only ornamental character."
  ]
}
